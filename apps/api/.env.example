# ============================================
# 🏗️ Construction SaaS — API Environment
# Copy to .env.local and fill in your values.
# ============================================

# ─── Database ───────────────────────────────────────────────
# Use a connection-pooled URL on production (Supabase pooler at port 6543).
# Use the direct URL only for migrations (DIRECT_URL, optional).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construction_saas?schema=public"

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
# Must equal the JWT secret configured in the Supabase project (Settings → API).
# If they don't match, every JWT will be rejected.
JWT_SECRET=your-supabase-jwt-secret

# ─── App ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated whitelist of allowed CORS origins (exact match).
# In production, set this to your real frontend domain(s).
# In development, localhost:3000 is auto-added.
CORS_ALLOWED_ORIGINS=https://app.tampalets.com,https://staging.tampalets.com

# Cookie signing secret (refresh-token httpOnly cookie — C11).
# Generate with:  openssl rand -hex 32
COOKIE_SECRET=

# Set to 'true' to enable Swagger /docs in production. Default off.
DOCS_ENABLED=false

# ─── Storage (used by Media service — pending F6 hardening) ─
STORAGE_BUCKET=construction-media
MAX_IMAGE_SIZE=10485760     # 10 MB
MAX_VIDEO_SIZE=104857600    # 100 MB
MAX_DOCUMENT_SIZE=26214400  # 25 MB

# ─── Malware scanning (Q6 — ClamAV via docker-compose) ──────
ENABLE_MALWARE_SCAN=false   # set to 'true' once ClamAV service is up
CLAMD_HOST=clamav
CLAMD_PORT=3310
